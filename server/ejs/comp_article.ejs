<%_if(article){_%>
<article class="article shadow corner collapsed">
  <a href="<%= getHref(article) %>">
      <address class="f6 text-gray"><%=article.title%></address>
  </a>
  <%_if(article.attrs && article.attrs.length){_%>
  <dl class="dict">
    <%_for(var i=0; i<article.attrs.length; i++){_%>
    <%_ const attr = article.attrs[i]; _%>
      <%_if(attr.value){_%>
      <dd<%if(attr.className){%> class="<%=attr.className%>"<%_}_%>><%=attr.value%></dd>
      <%_}_%>
      <%_if(attr.key){_%>
      <dt<%if(attr.desc){%> title="<%=attr.desc%>"<%_}_%>><%=attr.key%></dt>
      <%_}_%>
    <%_}_%>
  </dl>
  <%_}_%>
  <figure>
      <img src="<%= article.img || getSrc({ path: '/n_a.svg' }) %>" alt="<%=article.imgAlt%>" loading="lazy" data-role="imgerror">
      <figcaption><%=article.imgTag%></figcaption>
  </figure>
  <%_ const topTag = article.tags && article.tags[0]; _%>
  <%_if(topTag && (topTag.text || topTag.icon)){_%>
  <div class="tags-top">
    <span class="tag<%=topTag.className ? ' ' + topTag.className : ''%>"><%_if(topTag.icon){_%>
<i class="icon-<%=topTag.icon%>"></i>&nbsp;<%_}_%><%=topTag.text || ''%></span>
  </div>
  <%_}_%>
</article>
<%_}_%>
