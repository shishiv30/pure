<%_ if (record && record.length) { _%>
<%_ if (heading) { _%>
<h2 class="f4"><%= heading %></h2>
<%_ } _%>
<ul class="demo-detail-record">
	<%_ for (var r = 0; r < record.length; r++) { _%>
		<%_ const attr = record[r]; _%>
		<li>
			<%_ if (attr.value) { _%>
				<span<% if (attr.className) { %> class="<%= attr.className %>"<% } %>><%= attr.value %></span>
			<%_ } _%>
			<%_ if (attr.key) { _%>
				<abbr title="<%= attr.desc %>"><%= attr.key %></abbr>
			<%_ } _%>
		</li>
	<%_ } _%>
</ul>
<%_ } _%>
